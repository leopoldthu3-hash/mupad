{
  "name": "mupad",
  "version": "0.2.0",
  "private": true,
  "description": "A simple Python editor for iPad. Write normal Python, run it locally, and keep your scripts on your device.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leopoldthu3-hash/mupad.git"
  },
  "type": "module",
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node --check core.mjs && node --check www/app.js && node --check www/python-worker.js && node --check www/python-runner.mjs && node --check scripts/bundle.mjs && node --check scripts/prepare-native.mjs && node --test test/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "8.0.3",
    "pyodide": "^314.0.7"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@playwright/test": "1.64.0",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  }
}
